   "source": [
    "# 4.8 Cai dat Lasso: Coordinate Descent (pure Python)\n",
    "\n",
    "def _soft_threshold(z, gamma):\n",
    "    \"\"\"S(z, gamma) = sign(z) * max(|z| - gamma, 0)\"\"\"\n",
    "    if z > gamma:  return z - gamma\n",
    "    if z < -gamma: return z + gamma\n",
    "    return 0.0\n",
    "\n",
    "\n",
    "def lasso_fit(X, y, lam, max_iter=1000, tol=1e-6):\n",
    "    \"\"\"\n",
    "    Lasso bang Coordinate Descent (pure Python).\n",
    "    Tham so: X (Matrix n x p), y (Vector), lam (float).\n",
    "    Tra ve: list [intercept, beta1, ..., betap]\n",
    "    \"\"\"\n",
    "    n, p = X.shape\n",
    "    Xb = [[1.0] + [X[i][j] for j in range(p)] for i in range(n)]\n",
    "    p1 = p + 1\n",
    "    beta = [0.0] * p1\n",
    "    col_sq = [sum(Xb[i][j]**2 for i in range(n)) for j in range(p1)]\n",
    "    for _ in range(max_iter):\n",
    "        beta_old = beta[:]\n",
    "        for j in range(p1):\n",
    "            r_j   = [y[i] - sum(Xb[i][k]*beta[k] for k in range(p1) if k != j) for i in range(n)]\n",
    "            rho_j = sum(Xb[i][j]*r_j[i] for i in range(n))\n",
    "            cj    = col_sq[j]\n",
    "            if cj < 1e-14:\n",
    "                beta[j] = 0.0\n",
    "            elif j == 0:  # intercept: khong phat\n",
    "                beta[j] = rho_j / cj\n",
    "            else:\n",
    "                beta[j] = _soft_threshold(rho_j / cj, lam / cj)\n",
    "        if max(abs(beta[j]-beta_old[j]) for j in range(p1)) < tol:\n",
    "            break\n",
    "    return beta\n",
    "\n",
    "print('Da dinh nghia ham lasso_fit (coordinate descent, pure Python).')"
   ]
  },
