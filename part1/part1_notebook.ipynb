     "text": [
      "Tham số             β̂        SE         t    p-value CI 95%\n",
      "------------------------------------------------------------------------\n",
      "intercept       2.0355    0.0320   63.6237     0.0000  [1.9598, 2.1111] (*)\n",
      "x1              2.9946    0.0036  825.2121     0.0000  [2.9860, 3.0032] (*)\n",
      "x2              0.1010    0.0049   20.4151     0.0000  [0.0893, 0.1127] (*)\n",
