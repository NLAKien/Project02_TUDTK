    "        Xtr = Matrix([[X_m2[i][j] for j in range(p_r)] for i in train_i])\n",
    "        ytr = Vector([y_cv_v[i] for i in train_i])\n",
    "        br  = ridge_fit(Xtr, ytr, lam=lam_c)\n",
    "        mse_v = sum((y_cv_v[i] - (br[0] + sum(X_m2[i][j]*br[j+1] for j in range(p_r))))**2\n",
    "                    for i in val_i) / len(val_i)\n",
    "        mse_f.append(mse_v)\n",
    "    cv_ridge.append(sum(mse_f) / K_r)\n",
    "\n",
    "best_i   = cv_ridge.index(min(cv_ridge))\n",
    "best_lam = lam_cands[best_i]\n",
    "best_cv  = cv_ridge[best_i]\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(9, 4))\n",
    "ax.plot([math.log10(l) for l in lam_cands], cv_ridge,\n",
    "        color='steelblue', linewidth=2, marker='o', markersize=4)\n",
    "ax.axvline(math.log10(best_lam), color='red', linewidth=1.5, linestyle='--',\n",
    "           label=f'lam* = {best_lam:.4f}  CV = {best_cv:.4f}')\n",
    "ax.set_xlabel('log10(lam)', fontsize=12)\n",
    "ax.set_ylabel('CV Score (MSE)', fontsize=12)\n",
    "ax.set_title('Chon lam toi uu cho Ridge bang 5-Fold CV', fontsize=13, fontweight='bold')\n",
    "ax.legend(fontsize=10)\n",
    "ax.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(f'lam* toi uu = {best_lam:.4f}')\n",
    "print(f'CV Score*   = {best_cv:.6f}')\n",
    "print(f'OLS 5-fold  = {cv2:.6f}')\n",
    "delta = cv2 - best_cv\n",
    "cmt = 'Ridge tot hon OLS' if delta > 0 else 'OLS tot hon Ridge'\n",
    "print(f'Cai thien   = {delta:.6f}  => {cmt}')"
   ]
  },
