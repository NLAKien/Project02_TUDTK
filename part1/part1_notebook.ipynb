   "source": [
    "names   = [\"intercept\", \"x1\", \"x2\"]\n",
    "se      = standard_errors(X, sigma2_hat)\n",
    "t_stats = t_statistics(beta_hat, se)\n",
    "pvals   = p_values(t_stats, df)\n",
    "cis     = confidence_intervals(beta_hat, se, df, alpha=0.05)\n",
    "\n",
    "print(f\"{'Tham số':<12} {'β̂':>9} {'SE':>9} {'t':>9} {'p-value':>10} {'CI 95%'}\")\n",
    "print(\"-\" * 72)\n",
    "for j in range(p + 1):\n",
    "    lo, hi = cis[j]\n",
    "    sig = \" (*)\" if pvals[j] < 0.05 else \"    \"\n",
    "    print(f\"{names[j]:<12} {beta_hat[j]:>9.4f} {se[j]:>9.4f} \"\n",
    "          f\"{t_stats[j]:>9.4f} {pvals[j]:>10.4f}  \"\n",
    "          f\"[{lo:.4f}, {hi:.4f}]{sig}\")\n",
    "print()\n",
    "print(\"(*) p < 0.05: hệ số có ý nghĩa thống kê\")"
   ]
